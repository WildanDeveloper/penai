{
  "name": "penai",
  "version": "0.1.0",
  "description": "AI penetration testing core with a Go terminal client, for authorised engagements only",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "bin": {
    "penai": "dist/cmd/penai/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx cmd/penai/main.ts",
    "build": "tsc -p tsconfig.json",
    "build:tui": "make -C go build",
    "build:all": "npm run build && npm run build:tui",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:tui": "make -C go test",
    "test:all": "npm run typecheck && npm run test && npm run test:tui",
    "check:language": "node scripts/check-language.mjs",
    "check:all": "npm run test:all && npm run check:language",
    "catalog": "node scripts/generate-catalog.mjs",
    "tui": "PENAI_CORE=\"node $PWD/dist/cmd/penai/main.js\" ./bin/penai-tui",
    "start": "node dist/cmd/penai/main.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "pentest",
    "security",
    "tui",
    "terminal",
    "ai",
    "agent",
    "bubbletea"
  ],
  "main": "dist/cmd/penai/main.js"
}

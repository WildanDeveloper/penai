# PENAI reads these variables itself; there is no loader to run.
#
#   node --env-file=.env dist/cmd/penai/main.js
#   PENAI_CORE="node $PWD/dist/cmd/penai/main.js" ./bin/penai-tui
#
# Every one of them is optional: the defaults below are what you get with an
# empty file. Do not commit a filled-in copy.

# --- where things live ----------------------------------------------------
# Evidence and findings for an engagement.
PENAI_DATA_DIR=
# The config file the core reads and writes.
PENAI_CONFIG=
PENAI_ENGAGEMENT=untitled-engagement
PENAI_TESTER=

# --- model provider -------------------------------------------------------
# Nothing here is required. With no configuration at all PENAI talks to OpenCode
# Zen's anonymous tier, which serves zero-cost models with no account and no key:
# it sends the literal bearer token `public`, which is the gateway's own way of
# saying "no credential", not a secret of anybody's.
#
# The free tier is rate limited per model, so one free model may be busy while
# another answers. `/model` lists them, and `r` refetches the live list.
#
# To use a paid provider, point at it and give it a key:
#   PENAI_BASE_URL=https://api.openai.com/v1
#   PENAI_API_KEY=sk-...
#   PENAI_MODEL=gpt-4o-mini
# For Anthropic, set the kind and root as well:
#   PENAI_PROVIDER=anthropic
#   PENAI_BASE_URL=https://api.anthropic.com/v1
PENAI_BASE_URL=
PENAI_API_KEY=
PENAI_MODEL=

# Optional tuning
PENAI_TEMPERATURE=0.2
PENAI_MAX_TOKENS=4096

# --- policy ---------------------------------------------------------------
# safe     nothing runs without a human saying yes
# balanced safe and low risk run unattended, anything higher asks
# full     adds content discovery and fuzzing unattended
PENAI_MODE=balanced

# Seconds between two automatic tool runs, and the agent loop step cap.
PENAI_RATE_LIMIT=1
PENAI_MAX_STEPS=8

# Let the model run allowlisted binaries (nmap, curl, nuclei, ...). Off by
# default: the built-in tools need no external binary at all.
PENAI_ALLOW_SHELL=0

# Targets that are never allowed, comma-separated. A deny rule beats any allow
# rule, including a scope entry.
PENAI_DENY=

# --- request behaviour ----------------------------------------------------
PENAI_CONCURRENCY=24
PENAI_TIMEOUT_MS=10000
PENAI_EVIDENCE_LIMIT=200000
